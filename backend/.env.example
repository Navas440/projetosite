# Postgres (ex: Neon - https://neon.tech). Copie a connection string do seu projeto.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Connection direta (sem pooler), usada pelas migrations. Na Neon, é a versão "unpooled".
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Gere com: node -e "console.log(require('crypto').randomBytes(?).toString('hex'))"
# Segredo usado para assinar os tokens JWT do login. Gere um valor aleatório longo.
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Gere com: node -e "console.log(require('crypto').randomBytes(?).toString('hex'))"
PASSWORD_PEPPER="troque-por-um-valor-aleatorio-longo"

# Origem permitida para CORS. Necessária (o login usa cookie httpOnly, que exige
# uma origem concreta com credentials:true — "*" não funciona com cookies).
# Se não definida, usa http://localhost:3000 (dev local).
# CORS_ORIGIN="https://seusite.com"

# Gere com: node -e "console.log(require('crypto').randomBytes(?).toString('hex'))"
# Segredo usado para assinar os tokens CSRF (proteção das rotas /admin/livros*).
CSRF_SECRET="troque-por-um-valor-aleatorio-longo"

# Cloudflare R2 (S3-compatível), usado para upload de capa de livro. Opcional:
# se ausente, o endpoint de upload de capa responde 503, sem impedir o resto
# do servidor de subir.
# R2_ACCOUNT_ID="seu-account-id-cloudflare"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="vexon-capas"
# URL pública do bucket (use o "Public bucket URL" r2.dev por simplicidade, ou
# um domínio customizado depois).
# R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"
