# Postgres (ex: Neon - https://neon.tech). Copie a connection string do seu projeto.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Connection direta (sem pooler), usada pelas migrations. Na Neon, é a versão "unpooled".
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Gere com: node -e "console.log(require('crypto').randomBytes(?).toString('hex'))"
# Segredo usado para assinar os tokens JWT do login. Gere um valor aleatório longo.
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Gere com: node -e "console.log(require('crypto').randomBytes(?).toString('hex'))"
PASSWORD_PEPPER="troque-por-um-valor-aleatorio-longo"

# Origem permitida para CORS. Se não definida, libera qualquer origem (ok para dev).
# CORS_ORIGIN="https://seusite.com"
