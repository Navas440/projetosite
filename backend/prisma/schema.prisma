// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int               @id @default(autoincrement())
  nome          String
  email         String            @unique
  senhaHash     String
  isAdmin       Boolean           @default(false)
  bio           String?
  createdAt     DateTime          @default(now())
  refreshTokens RefreshToken[]
  favoritos     Favorito[]
  leituras      LeituraCapitulo[]
  comentarios   Comentario[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  revogadoEm DateTime?

  @@index([usuarioId])
}

model Livro {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  title     String
  tagline   String
  synopsis  String
  gradient  String
  progress  Int
  featured  Boolean    @default(false)
  capaUrl   String?
  createdAt DateTime   @default(now())
  capitulos Capitulo[]
  favoritos Favorito[]
}

model Capitulo {
  id          Int               @id @default(autoincrement())
  slug        String
  title       String
  excerpt     String
  content     String            @default("")
  order       Int
  livroId     Int
  livro       Livro             @relation(fields: [livroId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  leituras    LeituraCapitulo[]
  comentarios Comentario[]

  @@unique([livroId, slug])
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livroId   Int
  livro     Livro    @relation(fields: [livroId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([usuarioId, livroId])
  @@index([livroId])
}

model LeituraCapitulo {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  capituloId Int
  capitulo   Capitulo @relation(fields: [capituloId], references: [id], onDelete: Cascade)
  lidoEm     DateTime @default(now())

  @@unique([usuarioId, capituloId])
  @@index([capituloId])
}

model Comentario {
  id         Int      @id @default(autoincrement())
  texto      String
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  capituloId Int
  capitulo   Capitulo @relation(fields: [capituloId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([capituloId])
}
